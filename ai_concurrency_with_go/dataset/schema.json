{
  "$schema": "http://json-schema.org/draft-07/schema#",

  "title": "AI Pipeline Document",

  "type": "object",

  "properties": {
    "id": {
      "type": "integer"
    },

    "title": {
      "type": "string"
    },

    "content": {
      "type": "string"
    },

    "category": {
      "type": "string"
    },

    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },

  "required": [
    "id",
    "title",
    "content",
    "category",
    "created_at"
  ]
}